{
  "name": "simply-html",
  "version": "0.0.0",
  "private": true,
  "description": "Turn agent-made markdown/HTML into a beautiful, PIN-gated page with a hub. A page tool, not an app builder.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "simply-html": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "preview": "node dist/cli/index.js preview"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dompurify": "3.4.11",
    "github-slugger": "^2.0.0",
    "jsdom": "25.0.1",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-task-lists": "^2.1.1"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.7.0",
    "@vercel/blob": "^2.4.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.2",
    "vercel": "^54.0.0",
    "vitest": "^2.1.2"
  }
}
