{
  "name": "simply-html",
  "version": "0.0.0",
  "private": true,
  "description": "Make your AI agent's markdown come alive — turn a plan, report, or doc into a dynamic, interactive HTML page (even a tiny app) you can read, edit by talking to it, and share.",
  "type": "module",
  "license": "MIT",
  "author": "aanishs (https://github.com/aanishs)",
  "homepage": "https://github.com/aanishs/simply-html#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aanishs/simply-html.git"
  },
  "bugs": {
    "url": "https://github.com/aanishs/simply-html/issues"
  },
  "keywords": [
    "html",
    "markdown",
    "ai",
    "agent",
    "llm",
    "claude",
    "sanitize",
    "dompurify",
    "reactive",
    "no-javascript",
    "agent-output",
    "html-over-markdown"
  ],
  "bin": {
    "simply-html": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "preview": "node dist/cli/index.js preview"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dompurify": "3.4.11",
    "github-slugger": "^2.0.0",
    "jsdom": "25.0.1",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-task-lists": "^2.1.1"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.7.0",
    "@vercel/blob": "^2.4.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.2",
    "vercel": "^54.0.0",
    "vitest": "^2.1.2"
  }
}
